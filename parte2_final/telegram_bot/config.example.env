# Copia este archivo a  .env  y rellena tus valores reales.
# Crea el bot con @BotFather en Telegram para obtener el token.
# Obtén tu CHAT_ID escribiéndole al bot y consultando getUpdates.

TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ
TELEGRAM_CHAT_ID=000000000

# Modelo YOLO de segmentación de instancias (ultralytics).
# Descarga automática la primera vez; recomendados: yolov8n-seg.pt / yolo11n-seg.pt
YOLO_MODEL=yolov8n-seg.pt

# Host/puerto donde el servicio escucha las peticiones del C++
API_HOST=0.0.0.0
API_PORT=8000
